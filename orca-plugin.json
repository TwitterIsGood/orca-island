{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "publisher": "twitterisgood",
  "id": "island-bridge",
  "name": "Orca Island",
  "version": "0.2.0",
  "description": "Shows Orca agent status in a native macOS Dynamic Island companion.",
  "author": { "name": "TwitterIsGood", "url": "https://github.com/TwitterIsGood" },
  "repository": "https://github.com/TwitterIsGood/orca-island",
  "license": "MIT",
  "engines": { "orca": ">=1.4.245" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [
      { "id": "orca-island.send-test", "title": "Orca Island: Send test event" },
      { "id": "orca-island.install-start", "title": "Orca Island: Install & Start" },
      { "id": "orca-island.open", "title": "Orca Island: Open" }
    ],
    "events": [{ "on": "agent.status.changed" }]
  },
  "capabilities": [{ "kind": "agent:read" }]
}
