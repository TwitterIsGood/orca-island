{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "publisher": "twitterisgood",
  "id": "island-bridge",
  "name": "Orca Island",
  "version": "0.2.2",
  "description": "Shows Orca agent status in a native macOS Dynamic Island companion.",
  "author": {
    "name": "TwitterIsGood",
    "url": "https://github.com/TwitterIsGood"
  },
  "repository": "https://github.com/TwitterIsGood/orca-island",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [
      {
        "id": "orca-island.send-test",
        "title": "Orca Island: Send test event"
      },
      {
        "id": "orca-island.install-start",
        "title": "Orca Island: Install & Start"
      },
      {
        "id": "orca-island.open",
        "title": "Orca Island: Open"
      },
      {
        "id": "orca-island.restart",
        "title": "Orca Island: Restart"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ],
    "statusBarItems": [
      {
        "id": "island",
        "text": "Island",
        "icon": "activity",
        "tooltip": "Orca Island · 点击重启",
        "command": "orca-island.restart"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
